{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Target availability",
      "id": 1,
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"cloudguard-ec2\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "CPU utilization",
      "id": 2,
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0},
      "targets": [{"expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{job=\"cloudguard-ec2\",mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Memory utilization",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"cloudguard-ec2\"} / node_memory_MemTotal_bytes{job=\"cloudguard-ec2\"}))", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Root filesystem utilization",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "100 * (1 - (node_filesystem_avail_bytes{job=\"cloudguard-ec2\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"cloudguard-ec2\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Network traffic",
      "id": 5,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"cloudguard-ec2\",device!~\"lo\"}[5m]))", "legendFormat": "Received {{instance}}", "refId": "A"},
        {"expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"cloudguard-ec2\",device!~\"lo\"}[5m]))", "legendFormat": "Transmitted {{instance}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 42,
  "tags": ["cloudguard", "ec2", "academic"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "CloudGuard EC2 Monitoring",
  "uid": "cloudguard-ec2",
  "version": 1
}
