aws_region      = "ap-south-1"
project_name    = "cloudguard"
environment     = "dev"
owner           = "ThamolwanRK"
instance_type   = "t3.micro"

# Replace with your current public IPv4 address followed by /32 before deployment.
monitoring_cidr = "203.0.113.10/32"

# Direct SSH is disabled by default. If temporarily enabled, use one trusted /32.
enable_ssh      = false
allowed_ssh_cidr = "203.0.113.10/32"
