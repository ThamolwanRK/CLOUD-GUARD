{
  "format_version": "1.2",
  "configuration": {
    "provider_config": {
      "aws": {
        "expressions": {
          "region": {"constant_value": "ap-south-1"}
        }
      }
    }
  },
  "resource_changes": [
    {
      "address": "aws_vpc.main",
      "type": "aws_vpc",
      "change": {
        "actions": ["create"],
        "after": {
          "tags_all": {
            "Name": "cloudguard-dev-vpc",
            "Project": "CloudGuard",
            "Environment": "dev",
            "Owner": "student",
            "ManagedBy": "Terraform"
          }
        }
      }
    },
    {
      "address": "aws_instance.web",
      "type": "aws_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "instance_type": "t3.micro",
          "root_block_device": [{"encrypted": true}],
          "metadata_options": [{"http_tokens": "required"}],
          "tags_all": {
            "Name": "cloudguard-dev-web",
            "Project": "CloudGuard",
            "Environment": "dev",
            "Owner": "student",
            "ManagedBy": "Terraform"
          }
        }
      }
    },
    {
      "address": "aws_vpc_security_group_ingress_rule.http",
      "type": "aws_vpc_security_group_ingress_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "from_port": 80,
          "to_port": 80,
          "cidr_ipv4": "0.0.0.0/0"
        }
      }
    }
  ]
}
