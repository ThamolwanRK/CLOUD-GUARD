{
  "format_version": "1.2",
  "configuration": {
    "provider_config": {
      "aws": {
        "expressions": {
          "region": {"constant_value": "ap-south-1"}
        }
      }
    }
  },
  "resource_changes": [
    {
      "address": "aws_instance.web",
      "type": "aws_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "instance_type": "t3.micro",
          "root_block_device": [{"encrypted": true}],
          "metadata_options": [{"http_tokens": "required"}],
          "tags_all": {
            "Name": "legacy-web-name",
            "Project": "CloudGuard",
            "Environment": "dev",
            "Owner": "student",
            "ManagedBy": "Terraform"
          }
        }
      }
    }
  ]
}
